# B44 studio analyzer severities. Canonical copy lives in B44.Standards;
# distributed via the B44.Standards package (global analyzer config, applies to
# every referencing project). Style/whitespace live in each repo's .editorconfig.
is_global = true
global_level = 100

# ── Code metrics (thresholds in CodeMetricsConfig.txt) ─────────────────────
# CA1502 cyclomatic complexity — disabled by default in the SDK; we enable it.
# Deliberately stricter than the SDK default (25) to keep coordinators and
# nested branching reviewable. Guardrail, not proof of bad design.
dotnet_diagnostic.CA1502.severity = warning

# ── Banned APIs (RS0030 fires from BannedSymbols lists) ────────────────────
dotnet_diagnostic.RS0030.severity = error

# ── Godot-repo accommodation ───────────────────────────────────────────────
# Godot repos must set GenerateAssemblyInfo=false (the export pipeline emits
# its own attributes), which makes CA1016 (assembly version) unsatisfiable.
# Package projects satisfy it via <Version> regardless.
dotnet_diagnostic.CA1016.severity = none
# CA1001 fires on Godot scene controllers holding engine resources whose
# lifetime the scene tree owns — engine-managed, not a leak. Core disposables
# are rare and review-caught.
dotnet_diagnostic.CA1001.severity = none

# ── String and culture semantics ───────────────────────────────────────────
# These are SDK rules that B44 already relies on: ambient equality, ordering,
# prefixes, casing, parsing and formatting all fail the build today, because
# every consumer runs TreatWarningsAsErrors and B44WarningPolicy keeps it that
# way. They are pinned here because that was contingent on AnalysisMode, which
# B44.Standards.props only DEFAULTS to Recommended: a consumer that set
# AnalysisMode=Default or Minimum for an unrelated reason silently lost the
# whole family, and B44W004 would not object — it rejects only None and
# AllDisabledByDefault. An explicit severity does not depend on the mode.
#
# Severity is deliberately warning, matching what these already are under
# Recommended. Consumers make them errors; this file does not escalate them.
# CA1304 culture-dependent casing; CA1311 the same call without a culture.
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1311.severity = warning
# CA1305 IFormatProvider on parse/format — ambient culture reaching a token.
dotnet_diagnostic.CA1305.severity = warning
# CA1309 ordinal instead of culture-sensitive equality and comparison.
dotnet_diagnostic.CA1309.severity = warning
# CA1310 StringComparison on the correctness-critical overloads.
dotnet_diagnostic.CA1310.severity = warning

# ── Meziantou curated allowlist (MeziantouAnalysisMode=None turns the rest
#    off; these opt back in). Defect-focused; style and speculative-perf
#    rules deliberately excluded. Validate empirically before promoting any
#    of these to error alongside TreatWarningsAsErrors. ─────────────────────
# Strings and input correctness
dotnet_diagnostic.MA0001.severity = warning
dotnet_diagnostic.MA0002.severity = warning
dotnet_diagnostic.MA0009.severity = warning
dotnet_diagnostic.MA0015.severity = warning
# Definite correctness problems
dotnet_diagnostic.MA0022.severity = warning
dotnet_diagnostic.MA0060.severity = warning
dotnet_diagnostic.MA0064.severity = warning
dotnet_diagnostic.MA0072.severity = warning
dotnet_diagnostic.MA0085.severity = warning
dotnet_diagnostic.MA0100.severity = warning
dotnet_diagnostic.MA0172.severity = warning
dotnet_diagnostic.MA0195.severity = warning
# Async hazards
dotnet_diagnostic.MA0035.severity = warning
dotnet_diagnostic.MA0042.severity = warning
dotnet_diagnostic.MA0134.severity = warning
dotnet_diagnostic.MA0147.severity = warning
dotnet_diagnostic.MA0155.severity = warning
# Forward an in-scope CancellationToken (added for the HTTP-client repos,
# where CT plumbing is heavy and forwarding gaps are the classic bug;
# near-zero noise in the games, which have no tokens in scope).
dotnet_diagnostic.MA0040.severity = warning
# Structure: method length (60 lines / 40 statements, configured below).
# MA0048 (one type per file) intentionally NOT enabled — cohesive multi-type
# files (StructuredGameLogger.cs, catalogs) are sanctioned B44 style.
# MA0051 is ADVISORY (suggestion): existing over-long methods are each
# repo's refactor backlog, and warning severity would fail the dotnet-format
# gate on findings that have no auto-fix. The ratchet test owns the hard
# structural limits; promote MA0051 per repo alongside TreatWarningsAsErrors
# once its backlog is cleared.
dotnet_diagnostic.MA0051.severity = suggestion
MA0051.maximum_lines_per_method = 60
MA0051.maximum_statements_per_method = 40

# ── Writable static state ──────────────────────────────────────────────────
# CA2211 (non-constant fields should not be visible) rejects an externally
# visible static field that is neither const nor readonly — shared mutable
# state any caller can reassign, with no owner and no ordering.
#
# Pinned for the same reason as the culture family above: the rule is NOT in
# the SDK's Default analysis mode. It ships enabled only from Minimum upward,
# so a consumer that sets AnalysisMode=Default loses it in silence, and
# B44W004 does not object because it rejects only None and AllDisabledByDefault.
#
# Severity is warning, matching Recommended; consumers make it an error. Zero
# such fields exist across the portfolio today, so this pins a clean state
# rather than widening one. It deliberately stops at externally visible fields:
# private static caches, lazily-assigned service holders and scene-lifetime
# singletons are outside its reach and are a design judgement, not a rule.
dotnet_diagnostic.CA2211.severity = warning
