<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>B44_TARGET_FRAMEWORK</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Required on current SDKs: without this, `dotnet test` restores and
         exits without running any xunit.v3 tests. B44.Standards fails the
         build if it goes missing, because that failure is otherwise green. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- The suite covers Core and must run on a machine with no engine
         installed. B44.Standards bans Godot and Unity symbols here and fails
         the build if an engine assembly reaches the reference graph — which a
         symbol analyzer cannot do for a dependency nothing has used yet. -->
    <B44EngineFree>true</B44EngineFree>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameName.Core\GameName.Core.csproj" />
  </ItemGroup>

  <!-- The engine guard that used to live here as a hand-written target is now
       B44EngineFree above. Do not paste a local copy back: shared behaviour is
       fixed in the B44 package that owns it, and the packaged check covers the
       families a filename list here kept missing (GodotPlugins, Unity package
       modules, engine source generators). -->
</Project>
