<Project>
  <PropertyGroup>
    <!-- Synchronized B44 organization and game guidance. The engine-free Core
         project is both the required architecture boundary and the
         once-per-build synchronization anchor. -->
    <B44AgentSyncEnabled>true</B44AgentSyncEnabled>
    <B44AgentGuidanceProfile>Game</B44AgentGuidanceProfile>
    <B44AgentRepositoryRoot>$(MSBuildThisFileDirectory)</B44AgentRepositoryRoot>
    <B44GameCoreProject>$(MSBuildThisFileDirectory)GameName.Core\GameName.Core.csproj</B44GameCoreProject>
    <B44AgentSyncProject>$(B44GameCoreProject)</B44AgentSyncProject>

    <!-- Source-size ratchet. Same anchor, so both repository-wide checks run
         once per build. The exclude list below is read by BOTH the gate and
         the baseline regenerator — that is why it lives here and not inside a
         test file. -->
    <B44RatchetEnabled>true</B44RatchetEnabled>
    <B44RatchetProject>$(B44GameCoreProject)</B44RatchetProject>
    <B44RatchetRepositoryRoot>$(MSBuildThisFileDirectory)</B44RatchetRepositoryRoot>
    <B44RatchetBaseline>$(MSBuildThisFileDirectory)ratchet-baseline.txt</B44RatchetBaseline>

    <!-- Repository-wide guardrails, sharing the ratchet's anchor and root.
         Hygiene fails the build when generated output, logs, or editor debris
         get committed. The suppression budget starts at 0: a new repository
         has nothing to suppress yet, so the first suppression is a decision
         somebody makes on purpose and raises here in the same change. -->
    <B44HygieneEnabled>true</B44HygieneEnabled>
    <B44SuppressionBudget>0</B44SuppressionBudget>
    <!-- Warnings stay visible and fail the build. New repositories start here;
         it is far cheaper than retrofitting warnings-as-errors later. -->
    <B44WarningPolicy>true</B44WarningPolicy>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Nullable>enable</Nullable>
    <!-- Surface editorconfig style/naming violations at build time so CI and
         local `dotnet build` catch drift instead of waiting for `dotnet format`. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required to make IDE0005 (remove unnecessary usings) fire at build time. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- We generate doc files to enable IDE0005, not to document every member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Godot carve-out: prevent the SDK from emitting TargetFrameworkAttribute /
       AssemblyInfo when Godot's export pipeline also emits them. Test projects
       keep them so test adapters discover the framework correctly. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exceed the ratchet by doctrine; .godot holds generated sources. -->
    <B44RatchetExclude Include="GameName.Tests" />
    <B44RatchetExclude Include=".godot" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal packages use compatibility-bounded floats in every consumer,
         including production. Pre-1.0, the minor version is the breaking
         boundary and crossing it is a deliberate act. -->
    <PackageReference Include="B44.Standards" Version="B44_STANDARDS_VERSION" PrivateAssets="all" />
  </ItemGroup>
</Project>
