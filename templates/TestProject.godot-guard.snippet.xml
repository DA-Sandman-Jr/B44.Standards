<!-- Retrofit for a test project that must stay engine-independent.

     This used to be a pasted <Target>. It is now one property, because
     B44.Standards 0.12.0 owns the check: it bans Godot and Unity symbols in
     the project and fails the build when an engine assembly or source
     generator reaches the resolved reference or analyzer graph — including
     the transitive case where the test project references the Godot
     presentation project, which a pasted list of package names missed.

     Delete any local PreventGodotDependencies target when you add this. Do not
     keep both: shared behaviour is fixed in the package that owns it, and a
     local copy drifts the moment the package learns a new engine assembly
     name. -->
<PropertyGroup>
  <B44EngineFree>true</B44EngineFree>
</PropertyGroup>
